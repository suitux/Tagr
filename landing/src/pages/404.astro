---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { t, localePath } from '../i18n';

const locale = 'en' as const;
const d = t(locale);
---

<BaseLayout
  locale={locale}
  path="/"
  title={d.meta.notFound.title}
  description={d.meta.notFound.description}
  noindex
>
  <section class="container-page flex min-h-[70dvh] flex-col justify-center py-20">
    <p class="font-mono text-sm text-[var(--muted-foreground)]">404</p>
    <h1 class="mt-3 text-[clamp(2rem,5vw,3.25rem)] font-semibold tracking-[-0.03em]">
      {d.notFound.h1}
    </h1>
    <p class="mt-4 max-w-md leading-relaxed text-[var(--muted-foreground)]">{d.notFound.body}</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={localePath(locale, '/')} class="btn-base btn-primary">{d.notFound.home}</a>
      <a href={localePath(locale, '/docs/')} class="btn-base btn-secondary">
        <Icon name="file-text" size={16} />
        {d.notFound.docs}
      </a>
    </div>
  </section>
</BaseLayout>
