---
import BaseLayout from '../layouts/BaseLayout.astro';
import Insights from '../components/Insights.astro';
import { t } from '../i18n';

const locale = 'en' as const;
const d = t(locale);
---

<BaseLayout
  locale={locale}
  path="/insights/"
  title={d.meta.insights.title}
  description={d.meta.insights.description}
  ogTitle={d.meta.insights.ogTitle}
>
  <Insights locale={locale} />
</BaseLayout>
