---
import Icon from './Icon.astro';

interface Props {
  code: string;
  lang?: string;
  copyLabel: string;
  copiedLabel: string;
  copyAria: string;
  /** "inline" is the single line variant: the button sits beside the code in its own cell
   *  instead of floating over it, so a long one liner never scrolls underneath the button. */
  size?: 'block' | 'inline';
  class?: string;
}

const {
  code,
  lang,
  copyLabel,
  copiedLabel,
  copyAria,
  size = 'block',
  class: className = '',
} = Astro.props;

const buttonClass =
  'js-copy inline-flex h-8 shrink-0 items-center gap-1.5 rounded-[var(--radius-md)] border border-[var(--border)] bg-[var(--background)] px-2.5 text-xs font-medium text-[var(--muted-foreground)] transition-colors hover:bg-[var(--accent)] hover:text-[var(--foreground)]';
---

{
  size === 'inline' ? (
    <div class={`surface flex items-center gap-2 overflow-hidden py-2 pr-2 pl-3 ${className}`}>
      <pre class="min-w-0 flex-1 overflow-x-auto text-[0.6875rem] leading-relaxed"><code class="font-mono text-[var(--card-foreground)]">{code}</code></pre>
      <button
        type="button"
        class={buttonClass}
        data-code={code}
        data-copy={copyLabel}
        data-copied={copiedLabel}
        aria-label={copyAria}
      >
        <Icon name="copy" size={14} />
        <span class="js-copy-text">{copyLabel}</span>
      </button>
    </div>
  ) : (
    <div class={`surface relative overflow-hidden ${className}`}>
      {lang && (
        <div class="flex items-center border-b border-[var(--border)] bg-[color-mix(in_oklch,var(--background)_50%,transparent)] px-4 py-2">
          <span class="font-mono text-xs text-[var(--muted-foreground)]">{lang}</span>
        </div>
      )}
      <button
        type="button"
        class={`${buttonClass} absolute right-2`}
        style={lang ? 'top: 0.4rem;' : 'top: 0.5rem;'}
        data-code={code}
        data-copy={copyLabel}
        data-copied={copiedLabel}
        aria-label={copyAria}
      >
        <Icon name="copy" size={14} />
        <span class="js-copy-text">{copyLabel}</span>
      </button>
      <pre class="overflow-x-auto p-4 pr-24 text-[0.8125rem] leading-relaxed"><code class="font-mono text-[var(--card-foreground)]">{code}</code></pre>
    </div>
  )
}
